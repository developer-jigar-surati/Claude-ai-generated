##############################################################################
#  Voice Agent OS — environment settings
#
#  HOW TO USE (non-technical friendly):
#    1. Copy this file and rename the copy to ".env"
#         cp .env.example .env
#    2. Fill in ONLY the values you want. Every line is OPTIONAL.
#    3. Save the file and restart the app (npm run dev).
#
#  The app works with a COMPLETELY EMPTY .env — it runs in "demo mode":
#  calls are simulated and intent detection uses a built-in parser.
#  Add keys below to turn individual features "live".
##############################################################################


# ─── Your brand name (shown in the dashboard header) ───────────────────────
# Change this to your company name. Safe to leave as-is.
WORKSPACE_NAME=Acme Corp


# ─── AI brain: Claude (Anthropic) ──────────────────────────────────────────
# Powers "smart" intent detection (understanding what a caller means).
# Without it, a simple built-in parser is used instead — still works.
# Get a key at: https://console.anthropic.com  →  API Keys
# It looks like: sk-ant-api03-xxxxxxxx
ANTHROPIC_API_KEY=

# Which Claude model to use. Leave as-is unless you know you want another.
# (A faster/cheaper option is "claude-haiku-4-5".)
ANTHROPIC_MODEL=claude-opus-5


# ─── Voice + phone calls: Vapi ─────────────────────────────────────────────
# This is what actually DIALS a real phone and talks. Without it, the app
# simulates calls (you still see real results on the dashboard).
# Get a key at: https://dashboard.vapi.ai  →  API Keys
VAPI_API_KEY=

# A phone number to call FROM. In Vapi: Phone Numbers → copy the number's ID.
VAPI_PHONE_NUMBER_ID=

# Advanced: only change if Vapi tells you to.
# VAPI_BASE_URL=https://api.vapi.ai


# ─── Telephony: Twilio (optional) ──────────────────────────────────────────
# Optional. Vapi can manage numbers for you, so most people can skip this.
# Get these at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=


# ─── Database (advanced, optional) ─────────────────────────────────────────
# By default the app stores everything in a local file (data/voiceagent.db).
# You normally do NOT need to set this. Change the file location if you want.
# DATABASE_FILE=./data/voiceagent.db
